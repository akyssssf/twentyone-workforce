APP_NAME="21 Kafe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# WAJIB true. SQLite mematikan foreign key secara bawaan — tanpa ini seluruh
# relasi antar tabel cuma dekorasi dan data yatim bisa muncul tanpa error.
DB_FOREIGN_KEYS=true
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Fingerspot (developer.fingerspot.io)
# ---------------------------------------------------------------------------
FINGERSPOT_API_URL=https://developer.fingerspot.io/api
FINGERSPOT_API_TOKEN=
FINGERSPOT_CLOUD_ID=
FINGERSPOT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Aturan absensi
# ---------------------------------------------------------------------------
ATTENDANCE_LATE_BLOCK_MINUTES=10
ATTENDANCE_LATE_BLOCK_DEDUCTION=5000
ATTENDANCE_LATE_GRACE_SECONDS=0
# Kosongkan kalau tidak ada batas. Isi YYYY-MM-DD kalau mesin baru terpasang
# dan tanggal-tanggal sebelumnya tidak boleh ikut kehitung.
ATTENDANCE_TRACKING_STARTS_ON=

###############################################################################
# WhatsApp
###############################################################################
#
# Dipakai mengirim kode lembur ke orang yang ditugaskan, dan meneruskan
# pengajuan ke admin.
#
# driver:
#   log    — tidak mengirim apa pun, cuma menulis ke storage/logs. BAWAAN.
#   fonnte — gateway lokal (fonnte.com). Daftar, sambungkan nomor lewat QR,
#            salin token. Paling sederhana untuk kafe.
#   cloud  — WhatsApp Cloud API resmi Meta. Butuh akun bisnis terverifikasi,
#            dan pesan bebas seperti kode lembur harus didaftarkan sebagai
#            template lebih dulu.
#
# Sengaja `log` secara bawaan: pesan nyasar ke nomor karyawan sungguhan saat
# mencoba-coba lebih mahal daripada pesan yang tidak terkirim.

WHATSAPP_DRIVER=log
WHATSAPP_ADMIN_NUMBER=6285876163554

FONNTE_TOKEN=
FONNTE_DELAY=2

# WHATSAPP_CLOUD_PHONE_ID=
# WHATSAPP_CLOUD_TOKEN=
