# public/build SENGAJA ikut masuk git.
#
# Hosting bersama seperti Hostinger sering tidak punya Node, dan memaksa
# membangun aset di sana adalah penghalang terbesar untuk deploy yang
# seharusnya cukup "git pull". Ongkosnya: berkas hasil build ikut tercatat di
# riwayat. Untuk proyek satu orang dengan satu tujuan deploy, itu tukar yang
# sepadan.
#
# Jalankan `npm run build` sebelum commit kalau menyentuh CSS atau JS.
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

# Database berisi data absensi dan gaji karyawan, jangan sampai ikut ke repo.
# -wal dan -shm adalah file pendamping mode WAL.
/database/*.sqlite
/database/*.sqlite-wal
/database/*.sqlite-shm

_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Foto wajah karyawan.
#
# Repo ini publik, dan berkas di sini adalah foto wajah orang sungguhan yang
# tidak pernah menyetujui wajahnya dipublikasikan. Aplikasi tetap jalan tanpa
# berkas ini: avatarUrl() mundur ke foto scan dari mesin, lalu ke inisial nama.
#
# Salin folder ini langsung ke server saat deploy, jangan lewat git.
/public/avatars/

# Salinan database hasil db:backup. Berisi seluruh data gaji dan absensi —
# tidak boleh masuk repo, apalagi repo publik.
/storage/app/backups/
